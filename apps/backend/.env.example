NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/maasuraksha
JWT_SECRET=change_this_to_a_secure_random_string_in_production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
ML_SERVICE_URL=http://localhost:8000

# Optional generative chat. Local resources work without these settings.
# Never put an API key in a VITE_* variable or commit a real .env.
CHAT_PROVIDER=local
OPENAI_API_KEY=
CHAT_MODEL=

# Optional dev-only admin seed (scripts/seed-admin.ts).
# Never commit real credentials.
ADMIN_SEED_NAME=
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
