# ===========================
# MaaSuraksha Environment Variables
# ===========================

# ---- Backend ----
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/maasuraksha
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# ---- ML Service ----
ML_SERVICE_URL=http://localhost:8000
ML_TIMEOUT_MS=1500
MODEL_DIR=./models
ARTIFACTS_DIR=./artifacts
DATA_DIR=./data
# Laptop-safe CPU training: bound XGBoost threads (default 2 on a 16 GB CPU laptop).
MAASURAKSHA_ML_THREADS=2

# ---- Frontend ----
VITE_API_URL=http://localhost:5000/api/v1
VITE_ML_SERVICE_URL=http://localhost:8000

# ---- Database (MongoDB) ----
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=password
MONGO_DB_NAME=maasuraksha

# ---- Development admin seed (scripts/seed-admin.ts) ----
# Optional; the script also accepts CLI flags. Never commit real values.
# Public registration never allows ADMIN accounts; this is a dev-only helper.
ADMIN_SEED_NAME=
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
